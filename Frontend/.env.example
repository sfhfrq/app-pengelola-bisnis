# =========================================================
# Contoh konfigurasi frontend.
# Salin menjadi .env kalau ingin diatur dari berkas:
#   cp .env.example .env
#
# CATATAN: saat `npm run dev`, dua nilai ini TIDAK perlu diisi.
# Proxy Vite sudah meneruskan /api ke http://localhost:3000.
# =========================================================

# Base path publik.
# Untuk GitHub Pages "project site" (https://user.github.io/nama-repo/),
# isinya HARUS "/nama-repo/" — kalau tidak, CSS dan JS akan 404.
VITE_BASE=/

# Alamat API backend.
# Kosongkan untuk development lokal.
# Saat build untuk hosting, isi dengan alamat backend di cloud:
# VITE_API_BASE=https://pengelola-bisnis-api.onrender.com/api
VITE_API_BASE=

const transaksiModel = require("../models/transaksiModel");
const ValidationError = require("../errors/ValidationError");

// LEVEL MODUL — dibuat sekali saat file di-load, bukan tiap request.
// Kalau ditaruh di dalam handler, array ini dibuat ulang setiap request = pemborosan.
const METODE_PEMBAYARAN_VALID = ["CASH", "QRIS", "TRANSFER"];

const createTransaksi = async (req, res, next) => {
    try {
        const { nama_pembeli, metode_pembayaran, produk } = req.body;

        // ---------- 1. Validasi data dasar ----------
        if (
            typeof nama_pembeli !== "string" ||
            nama_pembeli.trim() === "" ||
            !metode_pembayaran ||
            !produk
        ) {
            throw new ValidationError(
                "Nama pembeli, metode pembayaran, dan produk wajib diisi"
            );
        }

        // ---------- 2. Pastikan produk berupa array ----------
        if (!Array.isArray(produk) || produk.length === 0) {
            throw new ValidationError("Minimal harus ada satu produk");
        }

        // ---------- 3. Validasi metode pembayaran ----------
        if (!METODE_PEMBAYARAN_VALID.includes(metode_pembayaran)) {
            throw new ValidationError(
                `Metode pembayaran tidak valid. Pilihan: ${METODE_PEMBAYARAN_VALID.join(", ")}`
            );
        }

        // ---------- 4. Validasi tiap item ----------
        for (const item of produk) {
            if (
                !item ||
                !Number.isInteger(item.produk_id) ||
                !Number.isInteger(item.jumlah)
            ) {
                throw new ValidationError(
                    "produk_id dan jumlah harus berupa bilangan bulat"
                );
            }
            if (item.produk_id <= 0 || item.jumlah <= 0) {
                throw new ValidationError(
                    "produk_id dan jumlah harus lebih dari 0"
                );
            }
        }

        // ---------- 5. Kode transaksi ----------
        // Format: TRX-YYYYMMDD-<timestamp>
        // Panjang ~24 char, aman di kolom varchar(50).
        // Kolom kode_transaksi sudah UNIQUE → database jadi penjaga terakhir.
        const sekarang = new Date();
        const tahun = sekarang.getFullYear();
        const bulan = String(sekarang.getMonth() + 1).padStart(2, "0");
        const tanggal = String(sekarang.getDate()).padStart(2, "0");
        const kodeTransaksi = `TRX-${tahun}${bulan}${tanggal}-${Date.now()}`;

        // ---------- 6. Proses transaksi ----------
        const transaksi = await transaksiModel.createTransaksi({
            kodeTransaksi,
            userId: req.user.id,
            namaPembeli: nama_pembeli.trim(),
            metodePembayaran: metode_pembayaran,
            produk
        });

        return res.status(201).json({
            pesan: "Transaksi berhasil dibuat",
            data: transaksi
        });
    } catch (error) {
        // Semua error diserahkan ke global error handler (lihat app.js).
        // Kenapa? Supaya format response error KONSISTEN di seluruh API,
        // dan controller tetap fokus pada alur bisnis, bukan pada format error.
        next(error);
    }
};

module.exports = { createTransaksi };

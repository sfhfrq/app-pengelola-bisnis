<file path="middleware/errorMiddleware.js">
// Fungsi ini HARUS punya 4 parameter. Express mendeteksi error handler
// dari jumlah parameter (err, req, res, next). Kalau `next` dihapus,
// Express akan menganggapnya middleware biasa dan error Anda tidak tertangkap.
const errorMiddleware = (err, req, res, next) => {
    // Error yang kita lempar sendiri dari controller/model
    if (err.name === "ValidationError" || err.statusCode === 400) {
        return res.status(400).json({ pesan: err.message });
    }

    // Pelanggaran UNIQUE constraint dari MariaDB
    if (err.code === "ER_DUP_ENTRY") {
        return res.status(409).json({
            pesan: "Data sudah ada (duplikat)"
        });
    }

    // Pelanggaran FOREIGN KEY — produk dipakai di transaksi
    if (err.code === "ER_ROW_IS_REFERENCED_2") {
        return res.status(409).json({
            pesan: "Data tidak bisa dihapus karena masih dipakai"
        });
    }

    // Pelanggaran CHECK constraint
    if (err.code === "ER_CHECK_CONSTRAINT_VIOLATED") {
        return res.status(400).json({
            pesan: "Data melanggar aturan validasi database"
        });
    }

    // Sisanya = benar-benar bug server.
    // LOG LENGKAP ke terminal (untuk Anda), tapi JANGAN bocorkan detail ke
    // pengguna — stack trace SQL bisa membocorkan struktur database Anda.
    console.error("[error]", err);

    return res.status(500).json({
        pesan: "Terjadi kesalahan pada server"
    });
};

module.exports = errorMiddleware;
</file>

<file path="models/transaksiModel.js">
const db = require("../config/database");
const ValidationError = require("../errors/ValidationError");

const createTransaksi = async ({
    kodeTransaksi,
    userId,
    namaPembeli,
    metodePembayaran,
    produk
}) => {
    const connection = await db.getConnection();

    try {
        // =========================================================
        // LANGKAH 1 — BUKA TRANSAKSI PALING AWAL
        // =========================================================
        // JANGAN menaruh query apa pun sebelum baris ini.
        // `SELECT ... FOR UPDATE` hanya mengunci baris selama transaksi aktif.
        // Di mode autocommit (default MariaDB), statement di luar transaksi
        // langsung commit → lock-nya DILEPAS seketika → tidak ada gunanya.
        // Bug inilah yang kita perbaiki.
        await connection.beginTransaction();

        // =========================================================
        // LANGKAH 2 — NORMALISASI CART (gabungkan produk duplikat)
        // =========================================================
        // Struktur data: Hash Map → lookup O(1), total O(N).
        // Kalau pakai Array.find() → O(N²).
        // Sekaligus memperbaiki bug: request [{id:7,qty:1},{id:7,qty:1}]
        // harus dianggap qty=2, bukan dua baris terpisah.
        const qtyPerProduk = new Map();
        for (const item of produk) {
            qtyPerProduk.set(
                item.produk_id,
                (qtyPerProduk.get(item.produk_id) || 0) + item.jumlah
            );
        }

        // =========================================================
        // LANGKAH 3 — KUNCI BARIS DENGAN URUTAN KONSISTEN
        // =========================================================
        // sort() itu PENTING dan sering dilewatkan:
        // InnoDB mengunci baris satu per satu. Kalau transaksi A mengunci
        // (5,7) dan transaksi B mengunci (7,5), keduanya saling menunggu
        // → DEADLOCK. Urutan PK yang konsisten mencegahnya.
        const produkIds = [...qtyPerProduk.keys()].sort((a, b) => a - b);
        const placeholders = produkIds.map(() => "?").join(",");

        const [produkRows] = await connection.query(
            `SELECT id, nama_produk, harga, stok
             FROM produk
             WHERE id IN (${placeholders}) AND is_active = 1
             FOR UPDATE`,
            produkIds
        );

        if (produkRows.length !== produkIds.length) {
            throw new ValidationError("Ada produk yang tidak ditemukan");
        }

        // =========================================================
        // LANGKAH 4 — HITUNG SUBTOTAL
        // =========================================================
        // Map dari hasil query → lookup O(1) per item.
        const produkMap = new Map(produkRows.map((p) => [p.id, p]));

        let totalHarga = 0;
        const detailTransaksi = [];

        for (const [produkId, jumlah] of qtyPerProduk) {
            const p = produkMap.get(produkId);

            if (p.stok < jumlah) {
                throw new ValidationError(`Stok ${p.nama_produk} tidak mencukupi`);
            }

            const subtotal = Number(p.harga) * jumlah;
            totalHarga += subtotal;

            detailTransaksi.push({
                produk_id: p.id,
                jumlah,
                harga: p.harga,       // SNAPSHOT harga historis
                subtotal
            });
        }

        // =========================================================
        // LANGKAH 5 — INSERT TRANSAKSI UTAMA
        // =========================================================
        // status_pembayaran EKSPLISIT. Jangan bergantung pada DEFAULT:
        // DEFAULT itu "nilai cadangan", bukan "keputusan bisnis".
        // Kode harus menyatakan maksudnya sendiri, supaya bisa dibaca.
        const statusPembayaran = metodePembayaran === "QRIS" ? "PENDING" : "PAID";

        const [trxResult] = await connection.query(
            `INSERT INTO transaksi
             (kode_transaksi, user_id, nama_pembeli, total_harga,
              metode_pembayaran, status_pembayaran)
             VALUES (?, ?, ?, ?, ?, ?)`,
            [
                kodeTransaksi,
                userId,
                namaPembeli,
                totalHarga,
                metodePembayaran,
                statusPembayaran
            ]
        );

        const transaksiId = trxResult.insertId;

        // =========================================================
        // LANGKAH 6 — INSERT DETAIL: SATU QUERY UNTUK SEMUA BARIS
        // =========================================================
        // `VALUES ?` dengan array bersarang = bulk insert.
        // N baris → 1 round-trip jaringan (bukan N).
        const detailValues = detailTransaksi.map((d) => [
            transaksiId,
            d.produk_id,
            d.jumlah,
            d.harga,
            d.subtotal
        ]);

        await connection.query(
            `INSERT INTO detail_transaksi
             (transaksi_id, produk_id, jumlah, harga, subtotal)
             VALUES ?`,
            [detailValues]
        );

        // =========================================================
        // LANGKAH 7 — KURANGI STOK DENGAN SATU QUERY (CASE)
        // =========================================================
        // Sebelumnya: loop → N round-trip. Sekarang: 1 round-trip.
        // Dan `stok >= CASE ... END` adalah guard atomik di level database:
        // kalau stok kurang, baris itu TIDAK ter-update → affectedRows berkurang.
        const caseSet = produkIds.map(() => "WHEN ? THEN stok - ?").join(" ");
        const caseGuard = produkIds.map(() => "WHEN ? THEN ?").join(" ");

        const setParams = [];
        const guardParams = [];
        for (const id of produkIds) {
            const qty = qtyPerProduk.get(id);
            setParams.push(id, qty);
            guardParams.push(id, qty);
        }

        const [updResult] = await connection.query(
            `UPDATE produk
             SET stok = CASE id ${caseSet} END
             WHERE id IN (${placeholders})
               AND stok >= CASE id ${caseGuard} END`,
            [...setParams, ...produkIds, ...guardParams]
        );

        // affectedRows jadi ASSERTION TUNGGAL untuk semua produk sekaligus
        if (updResult.affectedRows !== produkIds.length) {
            throw new ValidationError("Stok berubah atau tidak mencukupi");
        }

        // =========================================================
        // LANGKAH 8 — COMMIT
        // =========================================================
        await connection.commit();

        return {
            id: transaksiId,
            kode_transaksi: kodeTransaksi,
            total_harga: totalHarga,
            status_pembayaran: statusPembayaran
        };
    } catch (error) {
        // Rollback aman dipanggil walau beginTransaction belum sempat jalan
        await connection.rollback();
        throw error;
    } finally {
        // WAJIB. Tanpa ini, koneksi tidak kembali ke pool → pool habis →
        // server "hang" setelah 10 request. Bug yang sangat sulit dilacak.
        connection.release();
    }
};

module.exports = { createTransaksi };
</file>


const db = require("../config/database");

// GET semua produk AKTIF + pencarian + paginasi
const getAllProduk = async ({ cari = null, limit = 20, offset = 0 } = {}) => {
    const [rows] = await db.query(
        `SELECT id, nama_produk, harga, stok, is_active
         FROM produk
         WHERE is_active = 1
           AND (? IS NULL OR nama_produk LIKE CONCAT('%', ?, '%'))
         ORDER BY id
         LIMIT ? OFFSET ?`,
        [cari, cari, limit, offset]
    );
    return rows;
};

// GET produk berdasarkan ID
const getProdukById = async (id) => {
    const [rows] = await db.query(
        `SELECT id, nama_produk, harga, stok, is_active
         FROM produk
         WHERE id = ? AND is_active = 1
         LIMIT 1`,
        [id]
    );
    return rows[0];
};

// POST produk
const createProduk = async ({ nama_produk, harga, stok }) => {
    const [result] = await db.query(
        `INSERT INTO produk (nama_produk, harga, stok)
         VALUES (?, ?, ?)`,
        [nama_produk, harga, stok]
    );
    return result;
};

// PUT produk
const updateProduk = async (id, { nama_produk, harga, stok }) => {
    const [result] = await db.query(
        `UPDATE produk
         SET nama_produk = ?, harga = ?, stok = ?
         WHERE id = ? AND is_active = 1`,
        [nama_produk, harga, stok, id]
    );
    return result;
};

// DELETE = SOFT DELETE (produk tidak benar-benar dihapus)
const deleteProduk = async (id) => {
    const [result] = await db.query(
        `UPDATE produk SET is_active = 0
         WHERE id = ? AND is_active = 1`,
        [id]
    );
    return result;
};


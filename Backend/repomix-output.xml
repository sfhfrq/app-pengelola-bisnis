<file path="app.js">
require("dotenv").config();   // ← WAJIB. Ini yang hilang di versi sebelumnya,
                              //   sehingga process.env.JWT_SECRET = undefined
                              //   saat file ini di-require oleh test.

const express = require("express");
const app = express();

const authRoutes = require("./routes/authRoutes");
const produkRoutes = require("./routes/produkRoutes");
const transaksiRoutes = require("./routes/transaksiRoutes");
const errorMiddleware = require("./middleware/errorMiddleware");

// Batasi ukuran body — cegah pengguna mengirim JSON 100 MB dan
// menghabiskan memori server (celah DoS sederhana).
app.use(express.json({ limit: "100kb" }));

// ---- Routes ----
app.use("/api/auth", authRoutes);
app.use("/api/produk", produkRoutes);
app.use("/api/transaksi", transaksiRoutes);   // ← route yang hilang kemarin

app.get("/", (req, res) => {
    res.status(200).json({ pesan: "App Pengelola Bisnis berjalan" });
});

// ---- 404 handler ----
// HARUS setelah semua route, dan SEBELUM error handler.
// Tanpa ini, endpoint salah ketik akan menggantung tanpa jawaban.
app.use((req, res) => {
    res.status(404).json({
        pesan: `Endpoint ${req.method} ${req.path} tidak ditemukan`
    });
});

// ---- Global error handler ----
// HARUS paling terakhir di antara semua app.use().
app.use(errorMiddleware);

module.exports = app;
</file>


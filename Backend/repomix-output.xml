<file path="server.js">
require("dotenv").config();

const app = require("./app");

const PORT = process.env.PORT || 3000;

const server = app.listen(PORT, () => {
    console.log(`Server berjalan di http://localhost:${PORT}`);
});

// ---- Graceful shutdown ----
// Saat Anda menekan Ctrl+C, proses tidak langsung dibunuh. Ia diberi
// kesempatan menutup koneksi yang sedang berjalan dengan rapi.
// Tanpa ini, transaksi database bisa terputus di tengah jalan.
const matikan = (sinyal) => {
    console.log(`\n${sinyal} diterima, menutup server...`);
    server.close(() => {
        console.log("Server ditutup dengan rapi.");
        process.exit(0);
    });
};

process.on("SIGINT", () => matikan("SIGINT"));    // Ctrl+C
process.on("SIGTERM", () => matikan("SIGTERM"));  // dihentikan sistem/Docker
</file>


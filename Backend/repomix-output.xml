<file path="controllers/authController.js">
const bcrypt = require("bcrypt");
const jwt = require("jsonwebtoken");
const userModel = require("../models/userModel");

const login = async (req, res) => {
    try {
        const { nama, password } = req.body;
        if (!nama || !password) {
            return res.status(400).json({
                pesan: "Nama dan password wajib diisi"
            });
        }
        const user = await userModel.getUserByNama(nama);
        if (!user) {
            return res.status(401).json({
                pesan: "Nama atau password salah"
            });
        }
        const passwordBenar = await bcrypt.compare(
            password,
            user.password
        );
        if (!passwordBenar) {
            return res.status(401).json({
                pesan: "Nama atau password salah"
            });
        }
        const token = jwt.sign(
            {
                id: user.id,
                nama: user.nama,
                role: user.role
            },
            process.env.JWT_SECRET,
            {
                expiresIn: "1h"
            }
        );
        res.status(200).json({
            pesan: "Login berhasil",
            token: token,
            user: {
                id: user.id,
                nama: user.nama,
                role: user.role
            }
        });
    } catch (error) {
        console.error(error);
        res.status(500).json({
            pesan: "Terjadi kesalahan pada server"
        });
    }
};

module.exports = {
    login
};
</file>

<file path="controllers/produkController.js">
const produkModel = require("../models/produkModel");
const ValidationError = require("../errors/ValidationError");

// GET semua produk
const getAllProduk = async (req, res, next) => {
    try {
        const cari = req.query.cari || null;
        // Batas atas WAJIB — cegah "unbounded query" (celah DoS paling umum di API)
        const limit = Math.min(Number(req.query.limit) || 20, 100);
        const offset = Math.max(Number(req.query.offset) || 0, 0);

        const produk = await produkModel.getAllProduk({ cari, limit, offset });

        res.status(200).json({
            data: produk,
            meta: { limit, offset, jumlah: produk.length }
        });
    } catch (error) {
        next(error);
    }
};

// GET produk berdasarkan ID
const getProdukById = async (req, res, next) => {
    try {
        const id = Number(req.params.id);
        if (!Number.isInteger(id) || id <= 0) {
            throw new ValidationError("ID tidak valid");
        }

        const produk = await produkModel.getProdukById(id);
        if (!produk) {
            return res.status(404).json({ pesan: "Produk tidak ditemukan" });
        }

        res.status(200).json({ data: produk });
    } catch (error) {
        next(error);
    }
};

// Validasi body produk — dipakai createProduk DAN updateProduk
// Kenapa dipisah? Karena duplikasi logika validasi = sumber bug saat salah satu lupa diubah.
const validasiProduk = (body) => {
    const { nama_produk, harga, stok } = body;

    const hargaNum = Number(harga);
    const stokNum = Number(stok);

    if (
        typeof nama_produk !== "string" ||
        nama_produk.trim() === "" ||
        !Number.isFinite(hargaNum) ||   // DECIMAL: boleh 3500.50
        hargaNum < 0 ||
        !Number.isInteger(stokNum) ||   // stok tetap bilangan bulat
        stokNum < 0
    ) {
        throw new ValidationError("Data produk tidak valid");
    }

    return {
        nama_produk: nama_produk.trim(),
        harga: hargaNum,
        stok: stokNum
    };
};

// POST produk
const createProduk = async (req, res, next) => {
    try {
        const data = validasiProduk(req.body);
        const result = await produkModel.createProduk(data);

        res.status(201).json({
            pesan: "Produk berhasil ditambahkan",
            id: result.insertId
        });
    } catch (error) {
        next(error);
    }
};

// PUT produk
const updateProduk = async (req, res, next) => {
    try {
        const id = Number(req.params.id);
        if (!Number.isInteger(id) || id <= 0) {
            throw new ValidationError("ID tidak valid");
        }

        const data = validasiProduk(req.body);
        const result = await produkModel.updateProduk(id, data);

        if (result.affectedRows === 0) {
            // affectedRows 0 bisa berarti: produk tidak ada, ATAU data sama persis
            const produk = await produkModel.getProdukById(id);
            if (!produk) {
                return res.status(404).json({ pesan: "Produk tidak ditemukan" });
            }
            return res.status(200).json({
                pesan: "Data produk tidak mengalami perubahan"
            });
        }

        res.status(200).json({ pesan: "Produk berhasil diubah" });
    } catch (error) {
        next(error);
    }
};

// DELETE produk (soft delete)
const deleteProduk = async (req, res, next) => {
    try {
        const id = Number(req.params.id);
        if (!Number.isInteger(id) || id <= 0) {
            throw new ValidationError("ID tidak valid");
        }

        const result = await produkModel.deleteProduk(id);
        if (result.affectedRows === 0) {
            return res.status(404).json({ pesan: "Produk tidak ditemukan" });
        }

        res.status(200).json({ pesan: "Produk berhasil dihapus" });
    } catch (error) {
        next(error);
    }
};

module.exports = {
    getAllProduk,
    getProdukById,
    createProduk,
    updateProduk,
    deleteProduk
};
</file>

<file path="middleware/authMiddleware.js">
const jwt = require("jsonwebtoken");

const authMiddleware = (req, res, next) => {
    try {
        const authHeader = req.headers.authorization;
        if (!authHeader) {
            return res.status(401).json({
                pesan: "Token tidak ditemukan"
            });
        }
               const authHeader = req.headers.authorization;

        // Periksa SKEMA, bukan hanya keberadaan header.
        // Tanpa cek ini, header "Token abc" atau "abc" akan diproses
        // dan menghasilkan error yang membingungkan.
        if (!authHeader || !authHeader.startsWith("Bearer ")) {
            return res.status(401).json({
                pesan: "Format token tidak valid. Gunakan: Bearer <token>"
            });
        }

        const token = authHeader.slice(7);   // buang "Bearer " (7 karakter)
        const decoded = jwt.verify(
            token,
            process.env.JWT_SECRET
        );
        req.user = decoded;
        next();
       } catch (error) {
        // Bedakan: token kadaluarsa vs token palsu/rusak.
        // Untuk keamanan, pesannya tetap umum — tapi log-nya spesifik.
        const pesan =
            error.name === "TokenExpiredError"
                ? "Token sudah expired, silakan login ulang"
                : "Token tidak valid";

        return res.status(401).json({ pesan });
    }
};

module.exports = authMiddleware;
</file>

<file path="middleware/roleMiddleware.js">
const roleMiddleware = (...roles) => {
    return (req, res, next) => {
        if (!req.user) {
            return res.status(401).json({
                pesan: "User belum login"
            });
        }
        if (!roles.includes(req.user.role)) {
            return res.status(403).json({
                pesan: "Anda tidak memiliki akses"
            });
        }
        next();
    };
};

module.exports = roleMiddleware;
</file>


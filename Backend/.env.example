# =========================================================
# Contoh konfigurasi backend.
# Salin berkas ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
# Berkas .env TIDAK ikut ter-commit (lihat .gitignore).
# =========================================================

# Kunci penanda tangan token JWT.
# WAJIB diganti dengan nilai acak yang panjang dan rahasia.
# Cara membuat nilai acak:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_kunci_acak_yang_panjang

# ---------------------------------------------------------
# Database MySQL
# ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pengelola_bisnis

# Batas koneksi dalam pool. Penyedia cloud gratis biasanya membatasi
# jumlah koneksi, jadi jangan diset terlalu besar (5-10 sudah cukup).
DB_POOL_LIMIT=10

# ---------------------------------------------------------
# TLS ke database
# Nyalakan (true) kalau penyedia MySQL mewajibkan koneksi terenkripsi.
# ---------------------------------------------------------
DB_SSL=false

# Opsional: path berkas CA, hanya kalau penyedia memakai CA sendiri.
# DB_SSL_CA=./ca.pem

# ---------------------------------------------------------
# Port server. Penyedia hosting biasanya mengisi ini otomatis.
# ---------------------------------------------------------
PORT=3000

# ---------------------------------------------------------
# Daftar origin frontend yang boleh mengakses API, dipisah koma.
# Kosongkan saat development (proxy Vite sudah menangani).
# Wajib diisi saat hosting, contoh:
#   CORS_ORIGIN=https://namaanda.github.io
# ---------------------------------------------------------
CORS_ORIGIN=

# Isi "production" saat hosting.
NODE_ENV=development
